# ==============================================================================
# ProveIt — Autonomous AWS Deployment Agent & Self-Healing Engine
# Complete Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# 2. AWS SECRETS & CLOUD INFRASTRUCTURE
# ------------------------------------------------------------------------------
# Cloud execution mode: "mock" (safe offline simulation) | "aws" (live AWS resources)
CLOUD_MODE=mock

# AWS IAM Credentials (requires EC2, ECS, ECR, CloudWatch, SSM permissions)
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_SESSION_TOKEN=optional_temporary_session_token_if_using_sts
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# Managed ECR & ECS Deployment Targets
AWS_ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com
AWS_ECS_CLUSTER=proveit-production-cluster
AWS_S3_BUCKET=proveit-deployment-artifacts-us-east-1
ALLOWED_REGIONS=["us-east-1", "us-west-2", "eu-west-1"]
ALLOWED_INSTANCE_TYPES=["t3.micro", "t3.small", "t3.medium"]
MAX_MANAGED_INSTANCES=2

# ------------------------------------------------------------------------------
# 3. GITHUB SECRETS & CONTINUOUS DEPLOYMENT
# ------------------------------------------------------------------------------
# GitHub Personal Access Token (scopes: repo, workflow, read:org)
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
GITHUB_CLIENT_ID=your_github_oauth_client_id_here
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret_here
GITHUB_WEBHOOK_SECRET=your_github_webhook_hmac_secret_here
GITHUB_DEFAULT_ORG=7gen-engineering
PROVEIT_BOT_NAME=proveit-bot

# ------------------------------------------------------------------------------
# 4. OBSERVABILITY & LOG CONNECTION
# ------------------------------------------------------------------------------
# AWS CloudWatch Logs integration
CLOUDWATCH_LOG_GROUP=/aws/proveit/deployments
CLOUDWATCH_STREAM_NAME=agent-execution-stream

# Error & Performance Monitoring (optional)
SENTRY_DSN=https://your-sentry-dsn@o123456.ingest.sentry.io/789012
DATADOG_API_KEY=your_datadog_api_key_here
DATADOG_SITE=datadoghq.com

# ------------------------------------------------------------------------------
# 5. DATABASE & PROOF LEDGER (Supabase PostgreSQL / SQLite fallback)
# ------------------------------------------------------------------------------
# Local development default: sqlite:///./proveit.db
# Production Supabase PostgreSQL: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=sqlite:///./proveit.db
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# ------------------------------------------------------------------------------
# 6. LLM AGENT CONFIGURATION (Gemini 2.5 Flash / Groq)
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
MAX_AGENT_STEPS=25

# ------------------------------------------------------------------------------
# 7. DEPLOYMENT EXECUTION & REPO ANALYSIS
# ------------------------------------------------------------------------------
DEPLOY_TIMEOUT_SECONDS=600
SANDBOX_CONTAINER_TIMEOUT=300
HEALTH_CHECK_MAX_RETRIES=10
HEALTH_CHECK_INTERVAL_SECONDS=5
CHAOS_ENABLED=true
REQUIRE_APPROVAL_PROD=true

# ------------------------------------------------------------------------------
# 8. HACKATHON AUTH & SECURITY
# ------------------------------------------------------------------------------
DEMO_USERNAME=admin
DEMO_PASSWORD=proveit_demo_secret_2026
JWT_SECRET=super_secret_jwt_key_proveit_hackathon_change_in_prod
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=120
